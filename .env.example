# Public browser URL baked into the static build. Never put tokens here.
# Leave this empty for interim local preview (fixture, or the Vite proxy below).
VITE_WORKING_SET_URL=

# Image default, set by deploy/k3s/mirmicode/Dockerfile. Same-origin path.
# Caddy on the pod strips /working-set and proxies to CAHQ. The browser
# never calls cahq.tail21f530.ts.net, so CAHQ does not need CORS.
# VITE_WORKING_SET_URL=/working-set/api/v1/working-set

# Direct root resolves to /api/v1/working-set (requires browser CORS).
# CAHQ does not send that header today, so prefer the proxy below.
# VITE_WORKING_SET_URL=https://cahq.tail21f530.ts.net
# Explicit API endpoints are also supported:
# VITE_WORKING_SET_URL=https://cahq.tail21f530.ts.net/api/v1/working-set

# Interim Vite proxy on a tailnet machine, if you are not on the deployed host.
# Vite server.allowedHosts is [".tail21f530.ts.net"], so MagicDNS names on that
# suffix are accepted. See README.
# VITE_WORKING_SET_URL=http://127.0.0.1:5173/working-set/api/v1/working-set
# WORKING_SET_PROXY_TARGET=https://cahq.tail21f530.ts.net npm run dev
# Open http://127.0.0.1:5173. That port is not the real surface.
# See README for saved-source precedence.
# Upstream is https://cahq.tail21f530.ts.net/api/v1/working-set.
# working-set.tail21f530.ts.net is a stale hostname. Do not point the proxy at it.
