# Public browser URL; never include tokens or credentials.
# Empty uses the committed fixture unless this browser saved a live URL.
VITE_WORKING_SET_URL=
# Direct root resolves to /api/v1/working-set (requires browser CORS):
# VITE_WORKING_SET_URL=https://working-set.tail21f530.ts.net
# Explicit API endpoints are also supported.
# Recommended on the tailnet Mac with the development proxy:
# VITE_WORKING_SET_URL=http://127.0.0.1:5173/working-set/api/v1/working-set
# Start: WORKING_SET_PROXY_TARGET=https://working-set.tail21f530.ts.net npm run dev
# Open http://127.0.0.1:5173. See README for saved-source precedence.
